import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
# Load dataset
df = pd.read_csv("student_performance_raw.csv")
print("===== DATASET OVERVIEW =====")
print(df.head())
print("\nDataset Shape:")
print(df.shape)
print("\nColumn Information:")
print(df.info())
# Statistical summary
print("\n===== STATISTICAL SUMMARY =====")
print(df.describe())
# Missing values
print("\n===== MISSING VALUES =====")
print(df.isnull().sum())
# Duplicate values
print("\n===== DUPLICATES =====")
print("Number of duplicate rows:", df.duplicated().sum())
# ------------------------------------------------
# 1. Study Hours Distribution
# ------------------------------------------------
plt.figure(figsize=(8, 5))
sns.histplot(df["Study_Hours"], kde=True)
plt.title("Distribution of Study Hours")
plt.xlabel("Study Hours")
plt.ylabel("Number of Students")
plt.show()
# ------------------------------------------------
# 2. Average Score by Subject
# ------------------------------------------------
subjects = [
    "Math_Score",
    "Physics_Score",
    "Computer_Score"
]
average_scores = df[subjects].mean()
plt.figure(figsize=(8, 5))
average_scores.plot(kind="bar")
plt.title("Average Score by Subject")
plt.xlabel("Subject")
plt.ylabel("Average Score")
plt.xticks(rotation=0)
plt.show()
# ------------------------------------------------
# 3. Study Hours vs Math Score
# ------------------------------------------------
plt.figure(figsize=(8, 5))
sns.scatterplot(
    data=df,
    x="Study_Hours",
    y="Math_Score"
)
plt.title("Study Hours vs Math Score")
plt.xlabel("Study Hours")
plt.ylabel("Math Score")
plt.show()
# ------------------------------------------------
# 4. Attendance vs Average Score
# ------------------------------------------------
df["Average_Score"] = df[subjects].mean(axis=1)
plt.figure(figsize=(8, 5))
sns.scatterplot(
    data=df,
    x="Attendance",
    y="Average_Score"
)
plt.title("Attendance vs Average Score")
plt.xlabel("Attendance (%)")
plt.ylabel("Average Score")
plt.show()
# ------------------------------------------------
# 5. Correlation Analysis
# ------------------------------------------------
correlation = df[
    [
        "Study_Hours",
        "Attendance",
        "Math_Score",
        "Physics_Score",
        "Computer_Score"
    ]
].corr()
print("\n===== CORRELATION MATRIX =====")
print(correlation)
# Heatmap
plt.figure(figsize=(9, 6))
sns.heatmap(
    correlation,
    annot=True,
    fmt=".2f"
)
plt.title("Correlation Heatmap")
plt.show()
# ------------------------------------------------
# 6. Find Top Performing Students
# ------------------------------------------------
df["Average_Score"] = df[subjects].mean(axis=1)
top_students = df.sort_values(
    "Average_Score",
    ascending=False
).head(10)
print("\n===== TOP 10 STUDENTS =====")
print(
    top_students[
        [
            "Student_ID",
            "Gender",
            "Study_Hours",
            "Attendance",
            "Average_Score"
        ]
    ]
)
# ------------------------------------------------
# 7. Gender-wise Performance
# ------------------------------------------------
gender_performance = df.groupby("Gender")[subjects].mean()
print("\n===== GENDER-WISE PERFORMANCE =====")
print(gender_performance)

gender_performance.plot(
    kind="bar",
    figsize=(9, 5)
)
plt.title("Average Performance by Gender")
plt.xlabel("Gender")
plt.ylabel("Average Score")

plt.xticks(rotation=0)

plt.show()

# ------------------------------------------------
# FINAL INSIGHTS
# ------------------------------------------------
print("\n===== KEY INSIGHTS =====")

print("""
1. Study hours show a positive relationship with academic performance.
2. Students with higher attendance generally have better average scores.
3. The correlation heatmap helps identify relationships between
   study hours, attendance, and subject scores.
4. The average-score analysis identifies the highest-performing students.

5. Subject-wise and gender-wise comparisons provide additional
   insights into student performance.
""")

